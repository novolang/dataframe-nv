@test
fn test_sort_by_city_then_w_descending_matches_sqlite_7() [io]
    let keys = [DfSortKey { column: "city", descending: false }, DfSortKey { column: "w", descending: true }]
    match dftable.sort_positions(frame_7(), keys)
        Ok(p)  => test.assert(p == [29,
            34,
            9,
            17,
            3,
            2,
            19,
            21,
            14,
            0,
            10,
            11,
            30,
            25,
            5,
            12,
            6,
            8,
            15,
            18,
            27,
            31,
            7,
            1,
            32,
            22,
            28,
            20,
            24,
            26,
            33,
            13,
            16,
            35,
            23,
            4])
        Err(e) => test.fail("sort_positions failed: ${e.message()}")

@test
fn test_summary_matches_python_statistics_7() [io]
    let t = frame_7()
    test.case("w")
    match dftable.column(t, "w")
        Ok(c)  => check_summary(c,
            24,
            Some(29.197916666666668),
            Some(25.11743928708856),
            Some(10.3125),
            Some(26.75),
            Some(57.5625))
        Err(e) => test.fail("column failed: ${e.message()}")
    test.case("n")
    match dftable.column(t, "n")
        Ok(c)  => check_summary(c,
            30,
            Some(19.833333333333332),
            Some(43.894924169157555),
            Some(-16.5),
            Some(7.5),
            Some(48.25))
        Err(e) => test.fail("column failed: ${e.message()}")

