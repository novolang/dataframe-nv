    let cols = [
        DfColumn { name: "rid", cells: DfIntCells([0, 1, 2, 3, 4, 5, 6, 7, 8]),
        present: [true, true, true, true, true, true, true, true, true] },
        DfColumn { name: "city", cells: DfStrCells(["bergen", "narvik", "bodo", "narvik", "", "narvik", "bergen", "bergen", "narvik"]),
        present: [true, true, true, true, false, true, true, true, true] },
        DfColumn { name: "score", cells: DfIntCells([620, 951, 527, 546, 474, 1, 906, 570, 941]),
        present: [true, true, true, true, true, true, true, true, true] }]
    DfTable { columns: cols, rows: 9 }

@test
fn test_group_by_city_matches_sqlite_7() [io]
    let t = frame_7()
    match dfgroup.by(t, ["city"])
        Err(e) => test.fail("by failed: ${e.message()}")
        Ok(g)  =>
            test.case("the groups, in first-appearance order")
            test.assert(dftable.to_rows(dfgroup.keys(g)) == [["bergen"], ["oslo"], ["alta"], [""], ["bodo"], ["tromso"]])
            test.case("the sizes sum to the row count")
            test.assert(same_cells(dfcolumn.cells_of(dfgroup.sizes(g, "rows")),
                [DfIntCell(5), DfIntCell(11), DfIntCell(6), DfIntCell(1), DfIntCell(11), DfIntCell(2)]))
            test.case("DfCount over w")
            check_agg(g,
                t,
                "w",
                DfCount,
                [DfIntCell(3), DfIntCell(9), DfIntCell(6), DfIntCell(0), DfIntCell(5), DfIntCell(1)])
            test.case("DfSum over w")
            check_agg(g, t, "w", DfSum, [DfFloatCell(95.5),
                DfFloatCell(210.0),
                DfFloatCell(200.5),
                DfFloatCell(0.0),
                DfFloatCell(187.25),
                DfFloatCell(7.5)])
            test.case("DfMean over w")
            check_agg_empty(g, t, "w", DfMean)
            test.case("DfMin over w")
            check_agg_empty(g, t, "w", DfMin)
            test.case("DfMax over w")
            check_agg_empty(g, t, "w", DfMax)
            test.case("DfCount over n")
            check_agg(g,
                t,
                "n",
                DfCount,
                [DfIntCell(5), DfIntCell(10), DfIntCell(5), DfIntCell(1), DfIntCell(7), DfIntCell(2)])
            test.case("DfSum over n")
            check_agg(g, t, "n", DfSum, [DfIntCell(216),
                DfIntCell(152),
                DfIntCell(132),
                DfIntCell(86),
                DfIntCell(-77),
                DfIntCell(86)])
            test.case("DfMean over n")
            check_agg(g, t, "n", DfMean, [DfFloatCell(43.2),
                DfFloatCell(15.2),
                DfFloatCell(26.4),
                DfFloatCell(86.0),
                DfFloatCell(-11.0),
                DfFloatCell(43.0)])
            test.case("DfMin over n")
            check_agg(g, t, "n", DfMin, [DfIntCell(-17),
                DfIntCell(-34),
                DfIntCell(-39),
                DfIntCell(86),
                DfIntCell(-45),
                DfIntCell(36)])
            test.case("DfMax over n")
            check_agg(g, t, "n", DfMax, [DfIntCell(93),
                DfIntCell(94),
                DfIntCell(79),
                DfIntCell(86),
                DfIntCell(37),
                DfIntCell(50)])
            test.case("DfCount over ok")
            check_agg(g,
                t,
                "ok",
                DfCount,
                [DfIntCell(4), DfIntCell(9), DfIntCell(3), DfIntCell(1), DfIntCell(4), DfIntCell(2)])

@test
fn test_group_by_city_band_matches_sqlite_7() [io]
    let t = frame_7()
    match dfgroup.by(t, ["city", "band"])
        Err(e) => test.fail("by failed: ${e.message()}")
        Ok(g)  =>
            test.case("the groups, in first-appearance order")
            test.assert(dftable.to_rows(dfgroup.keys(g)) == [["bergen", "0"],
                ["oslo", "0"],
                ["alta", "2"],
                ["alta", "1"],
                ["", "2"],
                ["bodo", "0"],
                ["bodo", ""],
                ["bergen", "1"],
                ["bodo", "2"],
                ["oslo", "2"],
                ["bergen", "2"],
                ["oslo", ""],
                ["bodo", "1"],
                ["oslo", "1"],
                ["tromso", ""],
                ["tromso", "0"]])
            test.case("the sizes sum to the row count")
            test.assert(same_cells(dfcolumn.cells_of(dfgroup.sizes(g, "rows")), [DfIntCell(3),
                DfIntCell(4),
                DfIntCell(3),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(2),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(3),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(3),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(1)]))
            test.case("DfCount over w")
            check_agg(g, t, "w", DfCount, [DfIntCell(2),
                DfIntCell(4),
                DfIntCell(3),
                DfIntCell(3),
                DfIntCell(0),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(0),
                DfIntCell(2),
                DfIntCell(2),
                DfIntCell(1),
                DfIntCell(0),
                DfIntCell(1),
                DfIntCell(3),
                DfIntCell(0),
                DfIntCell(1)])
            test.case("DfSum over w")
            check_agg(g, t, "w", DfSum, [DfFloatCell(98.75),
                DfFloatCell(132.0),
                DfFloatCell(90.0),
                DfFloatCell(110.5),
                DfFloatCell(0.0),
                DfFloatCell(21.0),
                DfFloatCell(60.25),
                DfFloatCell(0.0),
                DfFloatCell(73.5),
                DfFloatCell(-5.75),
                DfFloatCell(-3.25),
                DfFloatCell(0.0),
                DfFloatCell(32.5),
                DfFloatCell(83.75),
                DfFloatCell(0.0),
                DfFloatCell(7.5)])
            test.case("DfMean over w")
            check_agg_empty(g, t, "w", DfMean)
            test.case("DfMin over w")
            check_agg_empty(g, t, "w", DfMin)
            test.case("DfMax over w")
            check_agg_empty(g, t, "w", DfMax)
            test.case("DfCount over n")
            check_agg(g, t, "n", DfCount, [DfIntCell(3),
                DfIntCell(4),
                DfIntCell(3),
                DfIntCell(2),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(2),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(0),
                DfIntCell(1),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(1)])
            test.case("DfSum over n")
            check_agg(g, t, "n", DfSum, [DfIntCell(140),
                DfIntCell(197),
                DfIntCell(15),
                DfIntCell(117),
                DfIntCell(86),
                DfIntCell(37),
                DfIntCell(-58),
                DfIntCell(-17),
                DfIntCell(-11),
                DfIntCell(-67),
                DfIntCell(93),
                DfIntCell(0),
                DfIntCell(-45),
                DfIntCell(22),
                DfIntCell(36),
                DfIntCell(50)])
            test.case("DfMean over n")
            check_agg_empty(g, t, "n", DfMean)
            test.case("DfMin over n")
            check_agg_empty(g, t, "n", DfMin)
            test.case("DfMax over n")
            check_agg_empty(g, t, "n", DfMax)
            test.case("DfCount over ok")
            check_agg(g, t, "ok", DfCount, [DfIntCell(2),
                DfIntCell(2),
                DfIntCell(1),
                DfIntCell(2),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(0),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(1),
                DfIntCell(2),
                DfIntCell(3),
                DfIntCell(1),
                DfIntCell(1)])

@test
fn test_innerjoin_on_city_matches_sqlite_7() [io]
    match dftable.select(frame_7(), ["id", "city"])
        Err(e) => test.fail("select failed: ${e.message()}")
        Ok(l)  =>
            match dftable.select(other_7(), ["city", "score"])
                Err(e) => test.fail("select failed: ${e.message()}")
                Ok(r)  =>
                    match dfjoin.join(l, r, "city", DfInnerJoin)
                        Err(e) => test.fail("join failed: ${e.message()}")
                        Ok(j)  =>
                            test.assert(dftable.names(j) == ["id", "city", "score"])
                            test.assert(dftable.rows(j) == 26)
                            test.assert(dftable.to_rows(j) == [["0", "bergen", "620"],
                                ["0", "bergen", "906"],
                                ["0", "bergen", "570"],
                                ["5", "bodo", "527"],
                                ["6", "bodo", "527"],
                                ["8", "bodo", "527"],
                                ["10", "bergen", "620"],
                                ["10", "bergen", "906"],
                                ["10", "bergen", "570"],
                                ["11", "bodo", "527"],
                                ["12", "bodo", "527"],
                                ["14", "bergen", "620"],
                                ["14", "bergen", "906"],
                                ["14", "bergen", "570"],
                                ["15", "bodo", "527"],
                                ["18", "bodo", "527"],
                                ["19", "bergen", "620"],
                                ["19", "bergen", "906"],
                                ["19", "bergen", "570"],
                                ["21", "bergen", "620"],
                                ["21", "bergen", "906"],
                                ["21", "bergen", "570"],
                                ["25", "bodo", "527"],
                                ["27", "bodo", "527"],
                                ["30", "bodo", "527"],
                                ["31", "bodo", "527"]])

