@test
fn test_group_by_city_matches_sqlite_42() [io]
    let t = frame_42()
    match dfgroup.by(t, ["city"])
        Err(e) => test.fail("by failed: ${e.message()}")
        Ok(g)  =>
            test.case("the groups, in first-appearance order")
            test.assert(dftable.to_rows(dfgroup.keys(g)) == [["oslo"], [""], ["alta"], ["tromso"], ["bergen"], ["bodo"]])
            test.case("the sizes sum to the row count")
            test.assert(same_cells(dfcolumn.cells_of(dfgroup.sizes(g, "rows")),
                [DfIntCell(7), DfIntCell(6), DfIntCell(5), DfIntCell(10), DfIntCell(7), DfIntCell(1)]))
            test.case("DfCount over w")
            check_agg(g,
                t,
                "w",
                DfCount,
                [DfIntCell(5), DfIntCell(5), DfIntCell(3), DfIntCell(9), DfIntCell(6), DfIntCell(1)])
            test.case("DfSum over w")
            check_agg(g, t, "w", DfSum, [DfFloatCell(30.75),
                DfFloatCell(188.5),
                DfFloatCell(75.25),
                DfFloatCell(226.75),
                DfFloatCell(149.75),
                DfFloatCell(-5.0)])
            test.case("DfMean over w")
            check_agg(g, t, "w", DfMean, [DfFloatCell(6.15),
                DfFloatCell(37.7),
                DfFloatCell(25.083333333333332),
                DfFloatCell(25.194444444444443),
                DfFloatCell(24.958333333333332),
                DfFloatCell(-5.0)])
            test.case("DfMin over w")
            check_agg(g, t, "w", DfMin, [DfFloatCell(-6.75),
                DfFloatCell(18.0),
                DfFloatCell(-3.0),
                DfFloatCell(0.0),
                DfFloatCell(4.0),
                DfFloatCell(-5.0)])
            test.case("DfMax over w")
            check_agg(g, t, "w", DfMax, [DfFloatCell(33.5),
                DfFloatCell(60.75),
                DfFloatCell(42.0),
                DfFloatCell(61.0),
                DfFloatCell(59.5),
                DfFloatCell(-5.0)])
            test.case("DfCount over n")
            check_agg(g,
                t,
                "n",
                DfCount,
                [DfIntCell(7), DfIntCell(5), DfIntCell(4), DfIntCell(9), DfIntCell(5), DfIntCell(1)])
            test.case("DfSum over n")
            check_agg(g, t, "n", DfSum, [DfIntCell(270),
                DfIntCell(153),
                DfIntCell(-132),
                DfIntCell(315),
                DfIntCell(229),
                DfIntCell(57)])
            test.case("DfMean over n")
            check_agg(g, t, "n", DfMean, [DfFloatCell(38.57142857142857),
                DfFloatCell(30.6),
                DfFloatCell(-33.0),
                DfFloatCell(35.0),
                DfFloatCell(45.8),
                DfFloatCell(57.0)])
            test.case("DfMin over n")
            check_agg(g, t, "n", DfMin, [DfIntCell(-38),
                DfIntCell(-48),
                DfIntCell(-42),
                DfIntCell(-23),
                DfIntCell(-10),
                DfIntCell(57)])
            test.case("DfMax over n")
            check_agg(g, t, "n", DfMax, [DfIntCell(89),
                DfIntCell(77),
                DfIntCell(-26),
                DfIntCell(74),
                DfIntCell(85),
                DfIntCell(57)])
            test.case("DfCount over ok")
            check_agg(g,
                t,
                "ok",
                DfCount,
                [DfIntCell(5), DfIntCell(6), DfIntCell(4), DfIntCell(6), DfIntCell(5), DfIntCell(1)])

