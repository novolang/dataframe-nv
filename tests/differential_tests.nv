@test
fn test_group_by_city_matches_sqlite_19() [io]
    let t = frame_19()
    match dfgroup.by(t, ["city"])
        Err(e) => test.fail("by failed: ${e.message()}")
        Ok(g)  =>
            test.case("the groups, in first-appearance order")
            test.assert(dftable.to_rows(dfgroup.keys(g)) == [["alta"], ["tromso"], ["bodo"], ["bergen"], ["oslo"], [""]])
            test.case("the sizes sum to the row count")
            test.assert(same_cells(dfcolumn.cells_of(dfgroup.sizes(g, "rows")),
                [DfIntCell(11), DfIntCell(5), DfIntCell(6), DfIntCell(4), DfIntCell(7), DfIntCell(3)]))
            test.case("DfCount over w")
            check_agg(g,
                t,
                "w",
                DfCount,
                [DfIntCell(9), DfIntCell(5), DfIntCell(4), DfIntCell(3), DfIntCell(6), DfIntCell(2)])
            test.case("DfSum over w")
            check_agg(g, t, "w", DfSum, [DfFloatCell(187.5),
                DfFloatCell(183.25),
                DfFloatCell(100.25),
                DfFloatCell(54.5),
                DfFloatCell(143.0),
                DfFloatCell(63.0)])
            test.case("DfMean over w")
            check_agg(g, t, "w", DfMean, [DfFloatCell(20.833333333333332),
                DfFloatCell(36.65),
                DfFloatCell(25.0625),
                DfFloatCell(18.166666666666668),
                DfFloatCell(23.833333333333332),
                DfFloatCell(31.5)])
            test.case("DfMin over w")
            check_agg(g, t, "w", DfMin, [DfFloatCell(-6.75),
                DfFloatCell(-7.25),
                DfFloatCell(9.25),
                DfFloatCell(-6.75),
                DfFloatCell(-7.75),
                DfFloatCell(18.75)])
            test.case("DfMax over w")
            check_agg(g, t, "w", DfMax, [DfFloatCell(57.5),
                DfFloatCell(59.0),
                DfFloatCell(37.25),
                DfFloatCell(44.75),
                DfFloatCell(52.5),
                DfFloatCell(44.25)])
            test.case("DfCount over n")
            check_agg(g,
                t,
                "n",
                DfCount,
                [DfIntCell(11), DfIntCell(5), DfIntCell(5), DfIntCell(3), DfIntCell(5), DfIntCell(3)])
            test.case("DfSum over n")
            check_agg(g, t, "n", DfSum, [DfIntCell(353),
                DfIntCell(181),
                DfIntCell(152),
                DfIntCell(-30),
                DfIntCell(256),
                DfIntCell(132)])
            test.case("DfMean over n")
            check_agg(g, t, "n", DfMean, [DfFloatCell(32.09090909090909),
                DfFloatCell(36.2),
                DfFloatCell(30.4),
                DfFloatCell(-10.0),
                DfFloatCell(51.2),
                DfFloatCell(44.0)])
            test.case("DfMin over n")
            check_agg(g, t, "n", DfMin, [DfIntCell(-44),
                DfIntCell(-7),
                DfIntCell(-21),
                DfIntCell(-15),
                DfIntCell(-42),
                DfIntCell(-24)])
            test.case("DfMax over n")
            check_agg(g, t, "n", DfMax, [DfIntCell(86),
                DfIntCell(97),
                DfIntCell(78),
                DfIntCell(-4),
                DfIntCell(83),
                DfIntCell(87)])
            test.case("DfCount over ok")
            check_agg(g,
                t,
                "ok",
                DfCount,
                [DfIntCell(8), DfIntCell(4), DfIntCell(5), DfIntCell(0), DfIntCell(5), DfIntCell(2)])

