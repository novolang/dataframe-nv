@test
fn test_sort_by_city_then_w_descending_matches_sqlite_42() [io]
    let keys = [DfSortKey { column: "city", descending: false }, DfSortKey { column: "w", descending: true }]
    match dftable.sort_positions(frame_42(), keys)
        Ok(p)  => test.assert(p == [20,
            4,
            7,
            22,
            35,
            31,
            17,
            33,
            27,
            16,
            10,
            24,
            28,
            2,
            0,
            23,
            30,
            1,
            21,
            26,
            25,
            14,
            5,
            29,
            9,
            6,
            32,
            13,
            15,
            12,
            11,
            19,
            8,
            3,
            18,
            34])
        Err(e) => test.fail("sort_positions failed: ${e.message()}")

@test
fn test_summary_matches_python_statistics_42() [io]
    let t = frame_42()
    test.case("w")
    match dftable.column(t, "w")
        Ok(c)  => check_summary(c,
            29,
            Some(22.96551724137931),
            Some(21.801532152286732),
            Some(3.5),
            Some(23.5),
            Some(37.75))
        Err(e) => test.fail("column failed: ${e.message()}")
    test.case("n")
    match dftable.column(t, "n")
        Ok(c)  => check_summary(c,
            31,
            Some(28.774193548387096),
            Some(45.21335324688888),
            Some(-13.5),
            Some(32.0),
            Some(70.5))
        Err(e) => test.fail("column failed: ${e.message()}")
