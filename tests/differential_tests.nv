@test
fn test_innerjoin_on_city_matches_sqlite_42() [io]
    match dftable.select(frame_42(), ["id", "city"])
        Err(e) => test.fail("select failed: ${e.message()}")
        Ok(l)  =>
            match dftable.select(other_42(), ["city", "score"])
                Err(e) => test.fail("select failed: ${e.message()}")
                Ok(r)  =>
                    match dfjoin.join(l, r, "city", DfInnerJoin)
                        Err(e) => test.fail("join failed: ${e.message()}")
                        Ok(j)  =>
                            test.assert(dftable.names(j) == ["id", "city", "score"])
                            test.assert(dftable.rows(j) == 47)
                            test.assert(dftable.to_rows(j) == [["4", "alta", "134"],
                                ["4", "alta", "388"],
                                ["4", "alta", "161"],
