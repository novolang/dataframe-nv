@test
fn test_innerjoin_on_city_matches_sqlite_19() [io]
    match dftable.select(frame_19(), ["id", "city"])
        Err(e) => test.fail("select failed: ${e.message()}")
        Ok(l)  =>
            match dftable.select(other_19(), ["city", "score"])
                Err(e) => test.fail("select failed: ${e.message()}")
                Ok(r)  =>
                    match dfjoin.join(l, r, "city", DfInnerJoin)
                        Err(e) => test.fail("join failed: ${e.message()}")
                        Ok(j)  =>
                            test.assert(dftable.names(j) == ["id", "city", "score"])
                            test.assert(dftable.rows(j) == 53)
                            test.assert(dftable.to_rows(j) == [["0", "alta", "96"],
                                ["0", "alta", "185"],
                                ["0", "alta", "643"],
