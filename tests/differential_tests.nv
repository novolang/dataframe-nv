@test
fn test_sort_by_city_then_w_descending_matches_sqlite_19() [io]
    let keys = [DfSortKey { column: "city", descending: false }, DfSortKey { column: "w", descending: true }]
    match dftable.sort_positions(frame_19(), keys)
        Ok(p)  => test.assert(p == [0,
            31,
            5,
            13,
            19,
            23,
            21,
            18,
            6,
            16,
            32,
            10,
            4,
            27,
            29,
            15,
            3,
