// dffault.nv — every reason an operation in this package refuses.
//
// The package has one error type, as ndarray-nv does.  Every failure
// here is a request the data does not admit: a column that is not there,
// two columns of different lengths, a sum over text, a row off the end.
//
// Every variant carries what it was asked about.  `DfNoSuchColumn`
// carries the name that was asked for, `DfLengthMismatch` both lengths,
// `DfKindMismatch` both kinds and `DfRaggedRecord` the line of the
// record.
//
// `DfArrayFault` carries an `NdFault` from ndarray-nv unchanged, and its
// message includes that fault's message.  A caller who only calls
// `message()` does not need to know there are two error types.

// What a frame operation could not do.
//
// ```novo
// use dffault
//
// fn main() [io]
//     let e = DfNoSuchColumn("weight")
//     println(e.message())
// ```
pub enum DfFault
    // A column the frame does not have.  The name is what the caller
    // typed, so a typo shows as itself rather than as a position.
    DfNoSuchColumn(name: Str)
    // Two columns in one frame with the same name.  A frame refuses it
    // when it is made, so a selection by name always has one answer.
    DfDuplicateColumn(name: Str)
    // A column whose length is not the frame's, a row of text not as
    // wide as its header, or a grouping handed a frame of another
    // length.  `want` is the length the operation was committed to.
    DfLengthMismatch(want: Int, got: Int)
    // An operation asked of a column whose element type cannot answer
    // it: a mean of text, a join of an Int key with a Str key, a cast
    // of a number to a truth.
    DfKindMismatch(want: DfKind, got: DfKind)
    // A conversion to a numeric array over a column that has nulls in
    // it, with no fill named.  See `dfcolumn`'s module comment: this
    // package will not silently turn a missing value into a NaN.
    DfNullInNumeric(name: Str, nulls: Int)
    // A row number off the end of the frame.
    DfRowOutOfRange(row: Int, rows: Int)
    // A slice whose bounds describe no frame, a quantile outside
    // `[0, 1]`, an empty group-by key list, or a list of kinds whose
    // length is not the header's.  `what` names the request.

    DfBadRange(what: Str)
    // An aggregation or a summary over no rows at all, where the
    // answer would have to be invented.  `count` and `sum` answer for
    // an empty group without this; `mean`, `min` and `max` do not.
    DfEmptyGroup(what: Str)
    // A mask handed to `filter` whose length is not the frame's, or
    // whose rank is not 1.  A frame's rows are a sequence, so a
    // selection over them is too.
    DfBadMask(want: Int, got: Int)
    // A CSV record whose field count is not the header's.  `line` is
    // the line the record started on, as csv-nv counts it from 1.
    DfRaggedRecord(line: Int, want: Int, got: Int)
    // The array arithmetic underneath said no.  The `NdFault` is
    // carried whole rather than restated.
    DfArrayFault(cause: NdFault)

// The rule every `DfFault` is printed by: name the column or the
// count, and print both sides of any comparison.
//
// `Result<T, E>` requires `E: Error` (SPEC § 3.4), so this impl is what
// makes every fallible signature in the package spellable.
impl Error for DfFault
    fn message(self) -> Str
        match self
            DfNoSuchColumn(name)            =>
                "no column named `${name}`"
            DfDuplicateColumn(name)         =>
                "two columns named `${name}` in one frame"
            DfLengthMismatch(want, got)     =>
                "a column of ${got} row(s) in a frame of ${want}"
            DfKindMismatch(want, got)       =>
                "a column of kind ${dfcell.kind_name(got)} where ${dfcell.kind_name(want)} was needed"
            DfNullInNumeric(name, nulls)    =>
                "`${name}` has ${nulls} null(s) and no fill was named"
            DfRowOutOfRange(row, rows)      =>
                "row ${row} of a frame with ${rows} row(s)"
            DfBadRange(what)                =>
                "${what} describes no frame"
            DfEmptyGroup(what)              =>
                "${what} of an empty group has no value"
            DfBadMask(want, got)            =>
                "a mask over ${got} row(s) against a frame of ${want}"
            DfRaggedRecord(line, want, got) =>
                "line ${line} has ${got} field(s) where the header names ${want}"
            DfArrayFault(cause)             =>
                "the array underneath: ${cause.message()}"
