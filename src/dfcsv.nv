// dfcsv.nv — csv-nv's records turned into a frame and back.
//
// Loading a CSV file takes three steps.  The host reads the bytes;
// csv-nv parses them into a `Header` and a list of `Row`s; this module
// turns those into a `DfTable`.  Only the first step performs input.
//
// `dftable.of_rows` takes rows of text from any source.  This module
// takes csv-nv's own values, and a record of the wrong width is refused
// with the line it started on, which a bare `[Str]` no longer carries.
//
// An empty field is a null, except in a Str column, where it is the
// empty string.  `dfcell.parse` is where that rule is applied.  A caller
// who needs the other reading loads the column as Str and casts it with
// `dfcolumn.cast`.

use dfcell
use dftable
use record

// A frame from csv-nv's header and records, with the kinds named.
//
// `DfRaggedRecord` for a record that is not as wide as the header,
// with the line the record started on.  `DfBadRange` when `kinds` is
// not as long as the header, and `DfDuplicateColumn` when the header
// repeats a name.
//
// ```novo
// use dfcsv
//
// fn main() [io]
//     let h = Header { names: ["n", "c"] }
//     let r = [Row { fields: ["1", "a"], line: 2, index: 0 }]
//     match dfcsv.of_records(h, r, [DfIntKind, DfStrKind])
//         Ok(t)  => println("${dftable.rows(t)}")
//         Err(e) => println(e.message())
// ```
pub fn of_records(header: Header, records: [Row], kinds: [DfKind]) -> Result<DfTable, DfFault>
    let width = list.len(header.names)
    if list.len(kinds) != width
        return Err(DfBadRange("${list.len(kinds)} kind(s) for ${width} column(s)"))
    dftable.of_rows(header.names, fields_of(header, records)!, kinds)

// A frame from csv-nv's header and records, with the kinds inferred.
//
// One pass per column through `dfcell.infer`: Int, then Float, then
// Bool, then Str, the narrowest that fits every field.  A column of
// identifiers that are all digits infers as Int, and a leading zero is
// then lost.  A loader that must keep one names its kinds with
// `of_records`.
//
// ```novo
// use dfcsv
//
// fn main() [io]
//     let h = Header { names: ["n"] }
//     let r = [Row { fields: ["1"], line: 2, index: 0 }]
//     match dfcsv.of_records_inferred(h, r)
//         Ok(t)  => println("${dftable.names(t)}")
//         Err(e) => println(e.message())
// ```
pub fn of_records_inferred(header: Header, records: [Row]) -> Result<DfTable, DfFault>
    of_records(header, records, infer_kinds(header, records)!)

// The kind each column of these records would be read at.
//
// What `of_records_inferred` runs before it builds anything.  A caller
// can read the guess, change one entry, and pass the list to
// `of_records`.  `DfRaggedRecord` for a record that is not as wide as
// the header.

//
// ```novo
// use dfcsv
//
// fn main() [io]
//     let h = Header { names: ["n"] }
//     let r = [Row { fields: ["1"], line: 2, index: 0 }]
//     match dfcsv.infer_kinds(h, r)
//         Ok(ks) => println("${list.len(ks)}")
//         Err(e) => println(e.message())
// ```
pub fn infer_kinds(header: Header, records: [Row]) -> Result<[DfKind], DfFault>
    let rows = fields_of(header, records)!
    var kinds: [DfKind] = []
    for j in 0..list.len(header.names)
        var texts: [Str] = []
        for r in rows
            list.push(texts, r[j])
        list.push(kinds, dfcell.infer(texts))
    Ok(kinds)

// This frame's rows as csv-nv records, ready for its writer.
//
// Each cell through `dfcell.render`, so a null is the empty field.  The
// `line` on each record is its 1-based position counting the header,
// and `index` is its 0-based row number — the numbering csv-nv's reader
// would have produced for the same file, so a round trip through the
// writer and back gives records that compare equal.
//
// The header comes back separately from `header_of`, because csv-nv's
// writer takes the two apart too.
//
// ```novo
// use dfcsv
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  => println("${list.len(dfcsv.to_records(t))}")
//         Err(e) => println(e.message())
// ```
pub fn to_records(t: DfTable) -> [Row]
    var out: [Row] = []
    var i = 0
    for fields in dftable.to_rows(t)
        list.push(out, Row { fields: fields, line: i + 2, index: i })
        i += 1
    out

// This frame's column names as a csv-nv header.
//
// ```novo
// use dfcsv
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1])])
//         Ok(t)  => println("${dfcsv.header_of(t).names}")
//         Err(e) => println(e.message())
// ```
pub fn header_of(t: DfTable) -> Header
    Header { names: dftable.names(t) }

// The records' fields, refusing a record that is not as wide as the
// header with the line it started on.
fn fields_of(header: Header, records: [Row]) -> Result<[[Str]], DfFault>
    let width = list.len(header.names)
    var rows: [[Str]] = []
    for r in records
        if list.len(r.fields) != width
            return Err(DfRaggedRecord(r.line, width, list.len(r.fields)))
        list.push(rows, r.fields[:])
    Ok(rows)
