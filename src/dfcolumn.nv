// dfcolumn.nv — one named, typed column, its null mask, and the rule
// for what a null does.
//
// A null is a missing value.  Position `i` of a column is null exactly
// when `present[i]` is false.  A null is never stored as a
// not-a-number, a zero or an empty string, because a source can hold
// those as values.  The rule below is the one every operation in the
// package follows, and the other modules refer to it.
//
// - In an aggregation, a null is skipped, and the aggregation divides by
//   the count of what remains.  `count` is the number of present values.
//   `sum` is the total of the present values, and zero for a column with
//   none.  `mean` is that total over the present count, and
//   `DfEmptyGroup` for a column with none.  `min` and `max` are the
//   smallest and largest present values, and `DfEmptyGroup` for a column
//   with none.
// - In a join key, a null matches nothing, not even a null on the other
//   side.  This is SQL's rule.  polars matches two nulls and pandas drops
//   the row.  A left join keeps a left row with a null key and fills its
//   right columns with nulls.
// - In a group-by key, a null is a group of its own, so the group sizes
//   sum to the row count.
// - In a filter, a row whose predicate is null is dropped.  A mask has no
//   nulls, so the rule is applied where a mask is made: `mask` reads a
//   null in a Bool column as false.
// - In a sort, nulls go last in both directions.
// - In a conversion to a numeric array, a null stops the call with
//   `DfNullInNumeric`.  `to_floats_or` takes the value to put in its
//   place.
//
// A column is not an `NdFloat`.  It has a name, a null mask, and an
// element type that may be Bool or Str, which an array does not.  A
// numeric column converts to an array for arithmetic, with the nulls
// decided at that point by the caller.
//
// The values are one list of one type, `DfFloatCells([Float])` and its
// three siblings, rather than a list of `DfCell`.  A list of doubles is
// one allocation; a list of tagged cells is one per value.

use std.float
use std.int
use dfcell
use ndfloat
use ndint
use ndbool
use ndshape

// One named column: its values, and which of them are there.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     let c = dfcolumn.floats("weight", [70.5, 82.0])
//     println("${dfcolumn.name(c)} has ${dfcolumn.len(c)} row(s)")
// ```
pub struct DfColumn
    // The column's name inside its frame.  Unique within a frame —
    // `dftable.of_columns` refuses a duplicate — but nothing stops a
    // loose column from sharing a name with another loose one.
    name: Str
    // The values, one list of one type.  Its length is the column's
    // length, including the positions that are null: a null still
    // occupies a slot, holding the type's zero, and `present` says not
    // to read it.
    cells: DfCells
    // Which positions hold a value.  Always the same length as
    // `cells`.  A column with no nulls carries an all-true list rather
    // than an absent one, so that every function reads one shape.
    present: [Bool]

// The values of a column, as one list of one type.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     let c = DfColumn { name: "n", cells: DfIntCells([1, 2]), present: [true, true] }
//     println("${dfcolumn.len(c)}")
// ```
pub enum DfCells
    // 64-bit floats.
    DfFloatCells(values: [Float])
    // 64-bit signed integers.
    DfIntCells(values: [Int])
    // Truths.
    DfBoolCells(values: [Bool])
    // Text.
    DfStrCells(values: [Str])

// A Float column with no nulls.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.len(dfcolumn.floats("w", [1.0, 2.0]))}")
// ```
pub fn floats(name: Str, values: [Float]) -> DfColumn
    DfColumn { name: name,
        cells: DfFloatCells(list.clone(values)),
        present: all_present(list.len(values)) }

// An Int column with no nulls.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.len(dfcolumn.ints("n", [1, 2, 3]))}")
// ```
pub fn ints(name: Str, values: [Int]) -> DfColumn
    DfColumn { name: name,
        cells: DfIntCells(list.clone(values)),
        present: all_present(list.len(values)) }

// A Bool column with no nulls.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.len(dfcolumn.bools("ok", [true, false]))}")
// ```
pub fn bools(name: Str, values: [Bool]) -> DfColumn
    DfColumn { name: name,
        cells: DfBoolCells(list.clone(values)),
        present: all_present(list.len(values)) }

// A Str column with no nulls.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.len(dfcolumn.strings("city", ["oslo"]))}")
// ```
pub fn strings(name: Str, values: [Str]) -> DfColumn
    DfColumn { name: name,
        cells: DfStrCells(list.clone(values)),
        present: all_present(list.len(values)) }

// A column of these cells, with a null wherever a cell is
// `DfNullCell`.
//
// The general constructor, and the slow one: it walks a list of tagged
// values to build the four-lists form.  It is here because a caller
// assembling a row at a time — from a database cursor, from a JSON
// array — has cells and not columns, and `DfKindMismatch` is what a
// list holding two different kinds gets.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.of_cells("n", [DfIntCell(1), DfNullCell, DfIntCell(3)], DfIntKind)
//         Ok(c)  => println("${dfcolumn.null_count(c)}")
//         Err(e) => println(e.message())
// ```
pub fn of_cells(name: Str, cells: [DfCell], k: DfKind) -> Result<DfColumn, DfFault>
    var present: [Bool] = []
    for cell in cells
        match dfcell.kind_of(cell)
            None    => list.push(present, false)
            Some(g) =>
                if g != k
                    return Err(DfKindMismatch(k, g))
                list.push(present, true)
    let values = match k
        DfFloatKind => DfFloatCells(list.map(cells, float_of))
        DfIntKind   => DfIntCells(list.map(cells, int_of))
        DfBoolKind  => DfBoolCells(list.map(cells, bool_of))
        DfStrKind   => DfStrCells(list.map(cells, str_of))
    Ok(DfColumn { name: name, cells: values, present: present })

// The same column with a null mask applied.
//
// `present[i] = false` makes position `i` missing; the value already
// there is left alone and stops being read.  A position that is already
// null stays null whatever the mask says.  `DfLengthMismatch` when the
// mask is not the column's length.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.with_nulls(dfcolumn.ints("n", [1, 2]), [true, false])
//         Ok(c)  => println("${dfcolumn.null_count(c)}")
//         Err(e) => println(e.message())
// ```
pub fn with_nulls(c: DfColumn, present: [Bool]) -> Result<DfColumn, DfFault>
    let n = list.len(c.present)
    if list.len(present) != n
        return Err(DfLengthMismatch(n, list.len(present)))
    var both: [Bool] = []
    for i in 0..n
        list.push(both, c.present[i] and present[i])
    Ok(DfColumn { name: c.name, cells: c.cells, present: both })

// This column's name.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println(dfcolumn.name(dfcolumn.ints("n", [1])))
// ```
pub fn name(c: DfColumn) -> Str
    c.name

// The same column under a different name.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println(dfcolumn.name(dfcolumn.rename(dfcolumn.ints("n", [1]), "count")))
// ```
pub fn rename(c: DfColumn, name: Str) -> DfColumn
    DfColumn { name: name, cells: c.cells, present: c.present }

// Which of the four types this column holds.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println(dfcell.kind_name(dfcolumn.kind(dfcolumn.ints("n", [1]))))
// ```
pub fn kind(c: DfColumn) -> DfKind
    match c.cells
        DfFloatCells(_) => DfFloatKind
        DfIntCells(_)   => DfIntKind
        DfBoolCells(_)  => DfBoolKind
        DfStrCells(_)   => DfStrKind

// How many rows this column has, nulls included.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.len(dfcolumn.ints("n", [1, 2, 3]))}")
// ```
pub fn len(c: DfColumn) -> Int
    list.len(c.present)

// How many of this column's rows are missing.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.null_count(dfcolumn.ints("n", [1, 2]))}")
// ```
pub fn null_count(c: DfColumn) -> Int
    var n = 0
    for p in c.present
        if not p
            n += 1
    n

// Whether one row of this column is missing.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.is_null(dfcolumn.ints("n", [1, 2]), 0)
//         Ok(b)  => println("${b}")
//         Err(e) => println(e.message())
// ```
pub fn is_null(c: DfColumn, row: Int) -> Result<Bool, DfFault>
    check_row(c, row)!
    Ok(not c.present[row])

// One row of this column, as a cell.
//
// A missing row is `DfNullCell` — which is why the answer is a
// `DfCell` and not a `?DfCell` wrapping one.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.cell(dfcolumn.ints("n", [1, 2]), 1)
//         Ok(v)  => println(dfcell.render(v))
//         Err(e) => println(e.message())
// ```
pub fn cell(c: DfColumn, row: Int) -> Result<DfCell, DfFault>
    check_row(c, row)!
    Ok(cell_at(c, row))

// Every row of this column, as cells.
//
// The readable form, and the expensive one — one tagged value per row.
// A caller doing arithmetic wants `to_floats`; a caller printing a
// small frame wants this.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${list.len(dfcolumn.cells_of(dfcolumn.ints("n", [1, 2])))}")
// ```
pub fn cells_of(c: DfColumn) -> [DfCell]
    var out: [DfCell] = []
    for i in 0..list.len(c.present)
        list.push(out, cell_at(c, i))
    out

// The rows a mask keeps, in order.
//
// The column-level half of `dftable.filter`: same rule, one column.
// `DfBadMask` when the mask is not the column's length or is not rank
// 1.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match ndbool.of_list([true, false], [2])
//         Ok(m)  =>
//             match dfcolumn.filter(dfcolumn.ints("n", [1, 2]), m)
//                 Ok(c)  => println("${dfcolumn.len(c)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn filter(c: DfColumn, keep: NdMask) -> Result<DfColumn, DfFault>
    let n = list.len(c.present)
    let got = ndbool.size(keep)
    if got != n or ndshape.rank(ndbool.shape(keep)) != 1
        return Err(DfBadMask(n, got))
    let marks = ndbool.to_list(keep)
    var positions: [Int] = []
    for i in 0..n
        if marks[i]
            list.push(positions, i)
    Ok(gather(c, positions))

// The rows at these positions, in the order given.
//
// The gather every reordering in the package is built out of: a sort
// produces positions and this applies them, a group-by holds positions
// and this reads them, a join produces two lists of positions and this
// applies each to its side.  A position may repeat.
// `DfRowOutOfRange` for one off the end.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.take(dfcolumn.ints("n", [10, 20, 30]), [2, 0])
//         Ok(c)  => println("${dfcolumn.len(c)}")
//         Err(e) => println(e.message())
// ```
pub fn take(c: DfColumn, positions: [Int]) -> Result<DfColumn, DfFault>
    let n = list.len(c.present)
    for p in positions
        if p < 0 or p >= n
            return Err(DfRowOutOfRange(p, n))
    Ok(gather(c, positions))

// This column as a numeric array, refusing a null.
//
// `DfNullInNumeric` naming the column and the count if there are any —
// see the null rule at the top of this module for why the refusal is
// deliberate.  An Int column widens; a Bool or Str column is
// `DfKindMismatch`.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.to_floats(dfcolumn.floats("w", [1.0, 2.0]))
//         Ok(a)  => println("${ndfloat.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn to_floats(c: DfColumn) -> Result<NdFloat, DfFault>
    let nulls = null_count(c)
    if nulls > 0 and (kind(c) == DfFloatKind or kind(c) == DfIntKind)
        return Err(DfNullInNumeric(c.name, nulls))
    to_floats_or(c, 0.0)

// This column as a numeric array, with every null replaced by a value
// the caller names.
//
// The escape from `to_floats`, and the caller has to write the number
// down — which is the point.  `NdFloat`'s own NaN is a perfectly good
// fill if that is what the caller means, and now it says so.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.to_floats_or(dfcolumn.floats("w", [1.0, 2.0]), 0.0)
//         Ok(a)  => println("${ndfloat.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn to_floats_or(c: DfColumn, fill: Float) -> Result<NdFloat, DfFault>
    match c.cells
        DfFloatCells(vs) =>
            var out: [Float] = []
            for i in 0..list.len(vs)
                list.push(out, (if c.present[i] then vs[i] else fill))
            float_array(out)
        DfIntCells(vs)   =>
            var out: [Float] = []
            for i in 0..list.len(vs)
                list.push(out, (if c.present[i] then int.to_float(vs[i]) else fill))
            float_array(out)
        _                => Err(DfKindMismatch(DfFloatKind, kind(c)))

// This column as an integer array, refusing a null.
//
// `DfKindMismatch` for anything but an Int column.  A Float column does
// not narrow here; `cast` is the call that truncates.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.to_ints(dfcolumn.ints("n", [1, 2]))
//         Ok(a)  => println("${ndint.sum(a)}")
//         Err(e) => println(e.message())
// ```
pub fn to_ints(c: DfColumn) -> Result<NdInt, DfFault>
    match c.cells
        DfIntCells(vs) =>
            let nulls = null_count(c)
            if nulls > 0
                return Err(DfNullInNumeric(c.name, nulls))
            int_array(vs)
        _              => Err(DfKindMismatch(DfIntKind, kind(c)))

// A Bool column as a mask, with every null read as false.
//
// The bridge from a predicate column to `dftable.filter`, and the
// place the null rule's "unknown is not keep" is applied.
// `DfKindMismatch` for a column that is not Bool.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.mask(dfcolumn.bools("ok", [true, false]))
//         Ok(m)  => println("${ndbool.count(m)}")
//         Err(e) => println(e.message())
// ```
pub fn mask(c: DfColumn) -> Result<NdMask, DfFault>
    match c.cells
        DfBoolCells(vs) =>
            var out: [Bool] = []
            for i in 0..list.len(vs)
                list.push(out, c.present[i] and vs[i])
            bool_array(out)
        _               => Err(DfKindMismatch(DfBoolKind, kind(c)))

// A mask of which rows are present.
//
// `dftable.filter` of this mask keeps the rows where this column has a
// value, which is the third way to meet a null at the array boundary,
// beside refusing it and filling it.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${ndbool.count(dfcolumn.present_mask(dfcolumn.ints("n", [1, 2])))}")
// ```
pub fn present_mask(c: DfColumn) -> NdMask
    bool_array(c.present)!

// A Float column over this rank-1 array, with no nulls.
//
// The way back from array arithmetic into a frame: compute with
// ndarray-nv, name the result, and put it back with
// `dftable.with_column`.  An array of any rank but 1 is
// `DfArrayFault(NdRankMismatch(1, rank))`, because a column is a
// sequence.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0], [2])
//         Ok(a)  =>
//             match dfcolumn.of_floats("w", a)
//                 Ok(c)  => println(dfcolumn.name(c))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn of_floats(name: Str, a: NdFloat) -> Result<DfColumn, DfFault>
    let r = ndfloat.rank(a)
    if r != 1
        return Err(DfArrayFault(NdRankMismatch(1, r)))
    Ok(floats(name, ndfloat.to_list(a)))

// An Int column over this rank-1 array, with no nulls.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match ndint.of_list([1, 2], [2])
//         Ok(a)  =>
//             match dfcolumn.of_ints("n", a)
//                 Ok(c)  => println(dfcolumn.name(c))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn of_ints(name: Str, a: NdInt) -> Result<DfColumn, DfFault>
    let r = ndint.rank(a)
    if r != 1
        return Err(DfArrayFault(NdRankMismatch(1, r)))
    Ok(ints(name, ndint.to_list(a)))

// The same column at a different element type.
//
// A null stays null at every cast.  The casts, from each kind:
//
// - Int to Float widens.  Float to Int truncates towards zero, which is
//   `ndfloat.to_int`'s rule, and an infinity or a not-a-number becomes
//   a null.
// - Bool to Int or Float is 1 and 0.
// - Every kind casts to Str through `dfcell.render`.
// - Str casts to every kind through `dfcell.parse`, and text that does
//   not parse becomes a null.
//
// An Int or a Float has no cast to Bool: `DfKindMismatch`.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.cast(dfcolumn.ints("n", [1, 2]), DfFloatKind)
//         Ok(c)  => println(dfcell.kind_name(dfcolumn.kind(c)))
//         Err(e) => println(e.message())
// ```
pub fn cast(c: DfColumn, to: DfKind) -> Result<DfColumn, DfFault>
    let from = kind(c)
    let allowed = from == to or to == DfStrKind or from == DfStrKind
        or from != DfFloatKind and to == DfFloatKind or from != DfIntKind and to == DfIntKind
    if not allowed
        return Err(DfKindMismatch(to, from))
    var out: [DfCell] = []
    for cell in cells_of(c)
        list.push(out, convert(cell, to))
    of_cells(c.name, out, to)

// How many present values this column has.
//
// The aggregations below are the ones a group-by runs, exposed on a
// loose column so that a caller with one column does not need a frame.
// Every one of them follows the null rule at the top of this module.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.count(dfcolumn.ints("n", [1, 2, 3]))}")
// ```
pub fn count(c: DfColumn) -> Int
    list.len(c.present) - null_count(c)

// The total of the present values.
//
// A Float column sums to a Float cell and an Int column to an Int
// cell; an all-null column sums to the type's zero, because the empty
// sum needs no error.  `DfKindMismatch` for a Bool or Str column.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.sum(dfcolumn.ints("n", [1, 2, 3]))
//         Ok(v)  => println(dfcell.render(v))
//         Err(e) => println(e.message())
// ```
pub fn sum(c: DfColumn) -> Result<DfCell, DfFault>
    match c.cells
        DfFloatCells(vs) =>
            var total = 0.0
            for i in 0..list.len(vs)
                if c.present[i]
                    total += vs[i]
            Ok(DfFloatCell(total))
        DfIntCells(vs)   =>
            var total = 0
            for i in 0..list.len(vs)
                if c.present[i]
                    total += vs[i]
            Ok(DfIntCell(total))
        _                => Err(DfKindMismatch(DfFloatKind, kind(c)))

// The mean of the present values, always as a Float.
//
// `DfEmptyGroup` for a column with no present values at all — the mean
// of nothing has no value, and 0.0 would be a wrong answer rather than
// a missing one.  `DfKindMismatch` for Bool or Str.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.mean(dfcolumn.ints("n", [1, 2, 3]))
//         Ok(v)  => println("${v}")
//         Err(e) => println(e.message())
// ```
pub fn mean(c: DfColumn) -> Result<Float, DfFault>
    let values = to_floats_or(c, 0.0)!
    let n = count(c)
    if n == 0
        return Err(DfEmptyGroup("mean"))
    Ok(ndfloat.sum(values) / int.to_float(n))

// The smallest present value.
//
// Defined at every kind, because Str and Bool order too — a `min` over
// names is the alphabetically first one, which is what a group-by of
// text asks for.  `DfEmptyGroup` when nothing is present.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.min(dfcolumn.ints("n", [3, 1, 2]))
//         Ok(v)  => println(dfcell.render(v))
//         Err(e) => println(e.message())
// ```
pub fn min(c: DfColumn) -> Result<DfCell, DfFault>
    extreme(c, Less, "min")

// The largest present value, on `min`'s terms.
//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     match dfcolumn.max(dfcolumn.ints("n", [3, 1, 2]))
//         Ok(v)  => println(dfcell.render(v))
//         Err(e) => println(e.message())
// ```
pub fn max(c: DfColumn) -> Result<DfCell, DfFault>
    extreme(c, Greater, "max")

// How many distinct present values this column has.
//
// Two values are the same when `dfcell.key` says so, so the two zeros of
// a float count once.  This is what `describe` reports as `unique`.

//
// ```novo
// use dfcolumn
//
// fn main() [io]
//     println("${dfcolumn.unique_count(dfcolumn.strings("c", ["a", "a", "b"]))}")
// ```
pub fn unique_count(c: DfColumn) -> Int
    var seen: HashSet<Str> = HashSet.new()
    for i in 0..list.len(c.present)
        if c.present[i]
            seen.add(dfcell.key(cell_at(c, i)))
    seen.len()

// A present mask with every position set.
fn all_present(n: Int) -> [Bool]
    var out: [Bool] = []
    for _ in 0..n
        list.push(out, true)
    out

fn check_row(c: DfColumn, row: Int) -> Result<Unit, DfFault>
    let n = list.len(c.present)
    if row < 0 or row >= n
        return Err(DfRowOutOfRange(row, n))
    Ok()

// One position as a cell, `DfNullCell` where the mask says so.  The
// caller has checked the position.
fn cell_at(c: DfColumn, i: Int) -> DfCell
    if not c.present[i]
        return DfNullCell
    match c.cells
        DfFloatCells(vs) => DfFloatCell(vs[i])
        DfIntCells(vs)   => DfIntCell(vs[i])
        DfBoolCells(vs)  => DfBoolCell(vs[i])
        DfStrCells(vs)   => DfStrCell(vs[i])

// The rows at checked positions, values and mask together.
fn gather(c: DfColumn, positions: [Int]) -> DfColumn
    var present: [Bool] = []
    for p in positions
        list.push(present, c.present[p])
    let cells = match c.cells
        DfFloatCells(vs) =>
            var out: [Float] = []
            for p in positions
                list.push(out, vs[p])
            DfFloatCells(out)
        DfIntCells(vs)   =>
            var out: [Int] = []
            for p in positions
                list.push(out, vs[p])
            DfIntCells(out)
        DfBoolCells(vs)  =>
            var out: [Bool] = []
            for p in positions
                list.push(out, vs[p])
            DfBoolCells(out)
        DfStrCells(vs)   =>
            var out: [Str] = []
            for p in positions
                list.push(out, vs[p])
            DfStrCells(out)
    DfColumn { name: c.name, cells: cells, present: present }

// The value a cell of the column's own kind holds, and the kind's zero
// for a null, which the present mask then says not to read.
fn float_of(cell: DfCell) -> Float
    match cell
        DfFloatCell(v) => v
        _              => 0.0

fn int_of(cell: DfCell) -> Int
    match cell
        DfIntCell(v) => v
        _            => 0

fn bool_of(cell: DfCell) -> Bool
    match cell
        DfBoolCell(v) => v
        _             => false

fn str_of(cell: DfCell) -> Str
    match cell
        DfStrCell(v) => v
        _            => ""

// A rank-1 array over these values.  `of_list` refuses only a shape
// whose size is not the data's length, and `[len]` is that length, so
// the `Err` arm is never taken.
fn float_array(xs: [Float]) -> Result<NdFloat, DfFault>
    match ndfloat.of_list(xs, [list.len(xs)])
        Ok(a)  => Ok(a)
        // cov: skip — a shape of [len] always fits its data
        Err(e) => Err(DfArrayFault(e))

fn int_array(xs: [Int]) -> Result<NdInt, DfFault>
    match ndint.of_list(xs, [list.len(xs)])
        Ok(a)  => Ok(a)
        // cov: skip — a shape of [len] always fits its data
        Err(e) => Err(DfArrayFault(e))

fn bool_array(xs: [Bool]) -> Result<NdMask, DfFault>
    match ndbool.of_list(xs, [list.len(xs)])
        Ok(m)  => Ok(m)
        // cov: skip — a shape of [len] always fits its data
        Err(e) => Err(DfArrayFault(e))

// One cell at kind `to`.  Truncation takes a float towards zero, and a
// float with no integer value, an infinity or a not-a-number, becomes a
// null, as does text that does not parse.
fn convert(cell: DfCell, to: DfKind) -> DfCell
    match (cell, to)
        (DfNullCell, _)              => DfNullCell
        (_, DfStrKind)               => DfStrCell(dfcell.render(cell))
        (DfIntCell(v), DfFloatKind)  => DfFloatCell(int.to_float(v))
        (DfBoolCell(v), DfFloatKind) => DfFloatCell((if v then 1.0 else 0.0))
        (DfBoolCell(v), DfIntKind)   => DfIntCell((if v then 1 else 0))
        (DfFloatCell(v), DfIntKind)  =>
            if v != v or v - v != 0.0
                return DfNullCell
            DfIntCell(float.to_int(v))
        _                            => dfcell.parse(dfcell.render(cell), to) ?? DfNullCell

// The present value that orders `want` against every other, or
// `DfEmptyGroup` naming `what` when nothing is present.
fn extreme(c: DfColumn, want: Ordering, what: Str) -> Result<DfCell, DfFault>
    var best = DfNullCell
    for i in 0..list.len(c.present)
        if c.present[i]
            let v = cell_at(c, i)
            if best == DfNullCell or dfcell.compare(v, best) == Some(want)
                best = v
    if best == DfNullCell
        return Err(DfEmptyGroup(what))
    Ok(best)
