// dfsummary.nv — a column or a whole frame, summarised.
//
// `of_column` answers a `DfSummary` struct with typed fields, which a
// program reads.  `describe` answers a frame with one row per column,
// which prints, sorts and joins like any other frame.
//
// Every statistic that may not exist is optional.  A Str column has no
// mean, a column with nothing present has no minimum, and a column with
// one present value has no sample standard deviation.
//
// The quantiles are linear-interpolated: the value at rank `q * (n - 1)`
// of the sorted present values, between the two neighbours when that
// rank is not whole.  This is numpy's default method and pandas's.
//
// The standard deviation is the sample one, divided by `n - 1`, which is
// pandas's default.
//
// Nulls are skipped throughout, and `nulls` counts them.

use std.float
use std.int
use std.math
use dfcell
use dfcolumn
use dftable

// One column's summary, with every number that may not exist typed as
// not existing.
//
// ```novo
// use dfsummary
//
// fn main() [io]
//     match dfsummary.of_column(dfcolumn.ints("n", [1, 2, 3]))
//         Ok(s)  => println("${s.column}: ${s.count} present")
//         Err(e) => println(e.message())
// ```
pub struct DfSummary
    // The column's name.
    column: Str
    // Which of the four types it holds.
    kind: DfKind
    // How many rows, nulls included.
    rows: Int
    // How many of them hold a value.
    count: Int
    // How many do not.  `rows - count`, spelled out because it is the
    // number a reader is looking for.
    nulls: Int
    // How many distinct present values, at every kind.
    unique: Int
    // The mean of the present values.  `None` for a Bool or Str
    // column, and for one with nothing present.
    mean: ?Float
    // The sample standard deviation, divided by `n - 1`.  `None` for a
    // non-numeric column and for one with fewer than two present
    // values.
    sd: ?Float
    // The smallest present value, as a cell so that text and truths
    // can have one.  `None` when nothing is present.
    min: ?DfCell
    // The 25th percentile of the present values, linear-interpolated.
    // `None` for a non-numeric column.
    q25: ?Float
    // The 50th — the median, on the same rule.
    median: ?Float
    // The 75th, on the same rule.
    q75: ?Float
    // The largest present value, on `min`'s terms.
    max: ?DfCell

// One column summarised.
//
// Defined at every kind: a Str column gets `rows`, `count`, `nulls`,
// `unique`, `min` and `max` and nothing else, which is what there is
// to say about text.
//
// ```novo
// use dfsummary
//
// fn main() [io]
//     match dfsummary.of_column(dfcolumn.floats("w", [1.0, 2.0, 3.0]))
//         Ok(s)  => println("${s.mean ?? 0.0}")
//         Err(e) => println(e.message())
// ```
pub fn of_column(c: DfColumn) -> Result<DfSummary, DfFault>
    let k = dfcolumn.kind(c)
    let n = dfcolumn.count(c)
    let numeric = (k == DfFloatKind or k == DfIntKind) and n > 0
    var mean: ?Float = None
    var sd: ?Float = None
    var q25: ?Float = None
    var median: ?Float = None
    var q75: ?Float = None
    if numeric
        let xs = sorted_present(c)
        let m = dfcolumn.mean(c)!
        mean = Some(m)
        if n > 1
            var squares = 0.0
            for x in xs
                squares += (x - m) * (x - m)
            sd = Some(math.sqrt(squares / int.to_float(n - 1)))
        q25 = Some(at_rank(xs, 0.25))
        median = Some(at_rank(xs, 0.5))
        q75 = Some(at_rank(xs, 0.75))
    let lo = match dfcolumn.min(c)
        Ok(v)  => Some(v)
        Err(_) => None
    let hi = match dfcolumn.max(c)
        Ok(v)  => Some(v)
        Err(_) => None
    Ok(DfSummary { column: dfcolumn.name(c), kind: k, rows: dfcolumn.len(c), count: n,
                   nulls: dfcolumn.null_count(c), unique: dfcolumn.unique_count(c), mean: mean, sd: sd,
                   min: lo, q25: q25, median: median, q75: q75, max: hi })

// Every column summarised, as a frame.
//
// One row per column of the input and one column per statistic:
// `column`, `kind`, `rows`, `count`, `nulls`, `unique`, `mean`, `sd`,
// `min`, `q25`, `median`, `q75`, `max`.  `column` and `kind` are Str,
// the four counts are Int, and the other numeric statistics are Float
// with a null where the statistic does not exist.  `min` and `max` are
// Str, written by `dfcell.render`, because the input columns may be of
// four different kinds.
//
// Rows come out in the input frame's column order.
//
// ```novo
// use dfsummary
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//         Ok(t)  =>
//             match dfsummary.describe(t)
//                 Ok(d)  => println("${dftable.rows(d)} row(s), one per column")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn describe(t: DfTable) -> Result<DfTable, DfFault>
    var names: [DfCell] = []
    var kinds: [DfCell] = []
    var rows: [DfCell] = []
    var counts: [DfCell] = []
    var nulls: [DfCell] = []
    var uniques: [DfCell] = []
    var means: [DfCell] = []
    var sds: [DfCell] = []
    var mins: [DfCell] = []
    var q25s: [DfCell] = []
    var medians: [DfCell] = []
    var q75s: [DfCell] = []
    var maxes: [DfCell] = []
    for c in t.columns
        let s = of_column(c)!
        list.push(names, DfStrCell(s.column))
        list.push(kinds, DfStrCell(dfcell.kind_name(s.kind)))
        list.push(rows, DfIntCell(s.rows))
        list.push(counts, DfIntCell(s.count))
        list.push(nulls, DfIntCell(s.nulls))
        list.push(uniques, DfIntCell(s.unique))
        list.push(means, float_cell(s.mean))
        list.push(sds, float_cell(s.sd))
        list.push(mins, text_cell(s.min))
        list.push(q25s, float_cell(s.q25))
        list.push(medians, float_cell(s.median))
        list.push(q75s, float_cell(s.q75))
        list.push(maxes, text_cell(s.max))
    dftable.of_columns([dfcolumn.of_cells("column", names, DfStrKind)!,
                        dfcolumn.of_cells("kind", kinds, DfStrKind)!,
                        dfcolumn.of_cells("rows", rows, DfIntKind)!,
                        dfcolumn.of_cells("count", counts, DfIntKind)!,
                        dfcolumn.of_cells("nulls", nulls, DfIntKind)!,
                        dfcolumn.of_cells("unique", uniques, DfIntKind)!,
                        dfcolumn.of_cells("mean", means, DfFloatKind)!,
                        dfcolumn.of_cells("sd", sds, DfFloatKind)!,
                        dfcolumn.of_cells("min", mins, DfStrKind)!,
                        dfcolumn.of_cells("q25", q25s, DfFloatKind)!,
                        dfcolumn.of_cells("median", medians, DfFloatKind)!,
                        dfcolumn.of_cells("q75", q75s, DfFloatKind)!,
                        dfcolumn.of_cells("max", maxes, DfStrKind)!])

// One quantile of one column's present values, linear-interpolated.
//
// The rule the summary's `q25`, `median` and `q75` are three cases of,
// exposed because a notebook wants the 90th and the 99th too.
// `DfBadRange` for a `q` outside `[0.0, 1.0]`, `DfEmptyGroup` for a
// column with nothing present, and `DfKindMismatch` for a non-numeric
// one.
//
// ```novo
// use dfsummary
//
// fn main() [io]
//     match dfsummary.quantile(dfcolumn.floats("w", [1.0, 2.0, 3.0, 4.0]), 0.5)
//         Ok(v)  => println("${v}")
//         Err(e) => println(e.message())
// ```
pub fn quantile(c: DfColumn, q: Float) -> Result<Float, DfFault>
    let k = dfcolumn.kind(c)
    if k != DfFloatKind and k != DfIntKind
        return Err(DfKindMismatch(DfFloatKind, k))
    if not (q >= 0.0 and q <= 1.0)
        return Err(DfBadRange("the quantile ${q}"))
    if dfcolumn.count(c) == 0
        return Err(DfEmptyGroup("quantile"))
    Ok(at_rank(sorted_present(c), q))

// How many nulls each column has, as a frame of two columns.
//
// One row per column of the input, with two columns: `column`, the
// name, and `nulls`, the count.

//
// ```novo
// use dfsummary
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  =>
//             match dfsummary.null_counts(t)
//                 Ok(d)  => println("${dftable.names(d)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn null_counts(t: DfTable) -> Result<DfTable, DfFault>
    var names: [Str] = []
    var nulls: [Int] = []
    for c in t.columns
        list.push(names, dfcolumn.name(c))
        list.push(nulls, dfcolumn.null_count(c))
    dftable.of_columns([dfcolumn.strings("column", names), dfcolumn.ints("nulls", nulls)])

// The present values of a numeric column as floats, smallest first.
fn sorted_present(c: DfColumn) -> [Float]
    var xs: [Float] = []
    for cell in dfcolumn.cells_of(c)
        match cell
            DfFloatCell(v) => list.push(xs, v)
            DfIntCell(v)   => list.push(xs, int.to_float(v))
            _              => ()
    list.sort(xs)
    xs

// The value at rank `q * (n - 1)` of sorted values, interpolated
// linearly between the two neighbours of a rank that is not whole.
// This is numpy's default method, "linear", and pandas's.
fn at_rank(xs: [Float], q: Float) -> Float
    let h = q * int.to_float(list.len(xs) - 1)
    let lo = float.to_int(math.floor(h))
    let hi = if lo + 1 < list.len(xs)
        lo + 1
    else
        lo
    xs[lo] + (h - int.to_float(lo)) * (xs[hi] - xs[lo])

fn float_cell(v: ?Float) -> DfCell
    match v
        Some(x) => DfFloatCell(x)
        None    => DfNullCell

fn text_cell(v: ?DfCell) -> DfCell
    match v
        Some(c) => DfStrCell(dfcell.render(c))
        None    => DfNullCell
