// dftable.nv — a frame: named columns over one shared length.
//
// Every column in a frame has the same length, and no two share a name.
// `of_columns` checks both, and every other function keeps them true.
//
// A frame has no row index.  A row is a position from 0 to
// `rows(t) - 1`, and two frames combine only where the caller says how:
// `dfjoin.join` on a named key, or `concat_rows` by column name.  An
// index a caller wants is a column, named in the join.  polars makes the
// same choice; pandas aligns on an index.
//
// `filter` takes an `NdMask` rather than a predicate over a row.  The
// mask is computed a column at a time in ndarray-nv, over unboxed
// numbers, and masks combine with `ndbool.both` and `ndbool.either`.
// `sort` takes a list of key columns rather than a comparator, for the
// same reason.  Nulls sort last in both directions.
//
// What a null does is stated once, in `dfcolumn`'s module comment.

use dfcell
use dfcolumn
use ndbool
use ndshape

// Named columns over one shared length.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  => println("${dftable.rows(t)} by ${dftable.width(t)}")
//         Err(e) => println(e.message())
// ```
pub struct DfTable
    // The columns, in the order a reader sees them.  Order is the
    // caller's and is preserved by everything except `select`, which
    // takes the order it was given.
    columns: [DfColumn]
    // How many rows every column has.  It is carried rather than
    // derived, so a frame with no columns still has a length.
    rows: Int

// How a sort orders by one column.
//
// ```novo
// use dftable
//
// fn main() [io]
//     let k = DfSortKey { column: "n", descending: false }
//     println(k.column)
// ```
pub struct DfSortKey
    // The column to order by.  `DfNoSuchColumn` at sort time if the
    // frame does not have it.
    column: Str
    // Largest first when true.  Nulls go last either way.
    descending: Bool

// A frame over these columns.
//
// `DfLengthMismatch` when they are not all the same length, and
// `DfDuplicateColumn` when two share a name.  An empty list is the
// 0-by-0 frame, which is what `empty` returns.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2]), dfcolumn.strings("c", ["a", "b"])])
//         Ok(t)  => println("${dftable.width(t)}")
//         Err(e) => println(e.message())
// ```
pub fn of_columns(columns: [DfColumn]) -> Result<DfTable, DfFault>
    if list.len(columns) == 0
        return Ok(empty())
    let rows = dfcolumn.len(columns[0])
    var seen: HashSet<Str> = HashSet.new()
    for c in columns
        if dfcolumn.len(c) != rows
            return Err(DfLengthMismatch(rows, dfcolumn.len(c)))
        if seen.has(c.name)
            return Err(DfDuplicateColumn(c.name))
        seen.add(c.name)
    Ok(DfTable { columns: list.clone(columns), rows: rows })

// The frame with no columns and no rows.
//
// ```novo
// use dftable
//
// fn main() [io]
//     println("${dftable.rows(dftable.empty())}")
// ```
pub fn empty() -> DfTable
    DfTable { columns: [], rows: 0 }

// A frame from a header and rows of text, with the kinds named.
//
// The generic loading path: a database cursor, a JSON array of arrays
// and a fixed-width file all arrive as strings in row order, and this
// turns them into columns.  Each field is read by `dfcell.parse`, so
// an empty field is a null at every kind except Str, and a field that
// does not parse is a null too — a loader that would rather reject the
// row checks `null_count` afterwards.
//
// `DfLengthMismatch` when a row is not as wide as the header, and
// `DfBadRange` when `kinds` is not as long as the header.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_rows(["n", "c"], [["1", "a"], ["2", "b"]], [DfIntKind, DfStrKind])
//         Ok(t)  => println("${dftable.rows(t)}")
//         Err(e) => println(e.message())
// ```
pub fn of_rows(header: [Str], rows: [[Str]], kinds: [DfKind]) -> Result<DfTable, DfFault>
    let width = list.len(header)
    if list.len(kinds) != width
        return Err(DfBadRange("${list.len(kinds)} kind(s) for ${width} column(s)"))
    for r in rows
        if list.len(r) != width
            return Err(DfLengthMismatch(width, list.len(r)))
    var columns: [DfColumn] = []
    for j in 0..width
        var cells: [DfCell] = []
        for r in rows
            list.push(cells, dfcell.parse(r[j], kinds[j]) ?? DfNullCell)
        list.push(columns, dfcolumn.of_cells(header[j], cells, kinds[j])!)
    let t = of_columns(columns)!
    Ok(DfTable { columns: t.columns, rows: list.len(rows) })

// How many rows this frame has.
//
// ```novo
// use dftable
//
// fn main() [io]
//     println("${dftable.rows(dftable.empty())}")
// ```
pub fn rows(t: DfTable) -> Int
    t.rows

// How many columns this frame has.
//
// ```novo
// use dftable
//
// fn main() [io]
//     println("${dftable.width(dftable.empty())}")
// ```
pub fn width(t: DfTable) -> Int
    list.len(t.columns)

// The column names, in frame order.
//
// ```novo
// use dftable
//
// fn main() [io]
//     println("${dftable.names(dftable.empty())}")
// ```
pub fn names(t: DfTable) -> [Str]
    var out: [Str] = []
    for c in t.columns
        list.push(out, c.name)
    out

// One column by name.  `DfNoSuchColumn` naming what was asked for.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1])])
//         Ok(t)  =>
//             match dftable.column(t, "n")
//                 Ok(c)  => println(dfcolumn.name(c))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn column(t: DfTable, name: Str) -> Result<DfColumn, DfFault>
    for c in t.columns
        if c.name == name
            return Ok(c)
    Err(DfNoSuchColumn(name))

// Whether this frame has a column by that name.
//
// The question `column` answers destructively.  A notebook checking
// what it loaded asks this; a notebook that knows what it loaded calls
// `column` and matches.
//
// ```novo
// use dftable
//
// fn main() [io]
//     println("${dftable.has(dftable.empty(), "n")}")
// ```
pub fn has(t: DfTable, name: Str) -> Bool
    for c in t.columns
        if c.name == name
            return true
    false

// These columns, in this order.
//
// A projection, and a reordering: the result's column order is the
// order of `names`, not the frame's.  A name twice is
// `DfDuplicateColumn`, and one the frame does not have is
// `DfNoSuchColumn`.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1]), dfcolumn.strings("c", ["a"])])
//         Ok(t)  =>
//             match dftable.select(t, ["c"])
//                 Ok(s)  => println("${dftable.names(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn select(t: DfTable, names: [Str]) -> Result<DfTable, DfFault>
    var out: [DfColumn] = []
    for n in names
        list.push(out, column(t, n)!)
    let picked = of_columns(out)!
    Ok(DfTable { columns: picked.columns, rows: t.rows })

// Every column except these.
//
// `DfNoSuchColumn` for a name the frame does not have — dropping
// something that was never there is far more often a typo than an
// intention, so it is refused rather than ignored.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1]), dfcolumn.strings("c", ["a"])])
//         Ok(t)  =>
//             match dftable.drop(t, ["c"])
//                 Ok(s)  => println("${dftable.names(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn drop(t: DfTable, names: [Str]) -> Result<DfTable, DfFault>
    for n in names
        if not has(t, n)
            return Err(DfNoSuchColumn(n))
    var out: [DfColumn] = []
    for c in t.columns
        if not list.contains(names, c.name)
            list.push(out, c)
    Ok(DfTable { columns: out, rows: t.rows })

// The frame with this column added, or the one of that name replaced.
//
// A replacement keeps the replaced column's position, and a new column
// goes on the end.  `DfLengthMismatch` when the column is not the
// frame's length.  A frame with no columns takes a column of any length
// and has that many rows afterwards.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  =>
//             match dftable.with_column(t, dfcolumn.floats("w", [1.0, 2.0]))
//                 Ok(s)  => println("${dftable.names(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn with_column(t: DfTable, c: DfColumn) -> Result<DfTable, DfFault>
    if list.len(t.columns) > 0 and dfcolumn.len(c) != t.rows
        return Err(DfLengthMismatch(t.rows, dfcolumn.len(c)))
    var out: [DfColumn] = []
    var replaced = false
    for old in t.columns
        if old.name == c.name
            list.push(out, c)
            replaced = true
        else
            list.push(out, old)
    if not replaced
        list.push(out, c)
    Ok(DfTable { columns: out, rows: dfcolumn.len(c) })

// The frame with one column renamed, in place.
//
// `DfNoSuchColumn` for the old name, `DfDuplicateColumn` when the new
// one is already taken.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1])])
//         Ok(t)  =>
//             match dftable.rename(t, "n", "count")
//                 Ok(s)  => println("${dftable.names(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn rename(t: DfTable, from: Str, to: Str) -> Result<DfTable, DfFault>
    if not has(t, from)
        return Err(DfNoSuchColumn(from))
    if from == to
        return Ok(t)
    if has(t, to)
        return Err(DfDuplicateColumn(to))
    var out: [DfColumn] = []
    for c in t.columns
        if c.name == from
            list.push(out, dfcolumn.rename(c, to))
        else
            list.push(out, c)
    Ok(DfTable { columns: out, rows: t.rows })

// The first `n` rows, or all of them if there are fewer.
//
// Clamping rather than failing, because "show me the top ten" of a
// three-row frame means three rows and not an error.  A negative `n`
// is the empty frame, for the same reason.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//         Ok(t)  => println("${dftable.rows(dftable.head(t, 2))}")
//         Err(e) => println(e.message())
// ```
pub fn head(t: DfTable, n: Int) -> DfTable
    let stop = if n < 0
        0
    else
        if n > t.rows
            t.rows
        else
            n
    window(t, 0, stop)

// The last `n` rows, clamped like `head`.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//         Ok(t)  => println("${dftable.rows(dftable.tail(t, 2))}")
//         Err(e) => println(e.message())
// ```
pub fn tail(t: DfTable, n: Int) -> DfTable
    let count = if n < 0
        0
    else
        if n > t.rows
            t.rows
        else
            n
    window(t, t.rows - count, t.rows)

// The rows `[start, stop)`.
//
// The range is half-open.  `DfBadRange` for a start past its stop or a
// bound off the frame.  Unlike `head`, a slice does not clamp, because
// it names both ends.

//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//         Ok(t)  =>
//             match dftable.slice(t, 1, 3)
//                 Ok(s)  => println("${dftable.rows(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn slice(t: DfTable, start: Int, stop: Int) -> Result<DfTable, DfFault>
    if start < 0 or stop > t.rows or start > stop
        return Err(DfBadRange("rows [${start}, ${stop}) of a frame of ${t.rows}"))
    Ok(window(t, start, stop))

// The rows a mask keeps, in order.
//
// The mask is built a column at a time: `dfcolumn.to_floats`, then an
// `ndfloat` comparison, then `ndbool.both` to combine two.  `DfBadMask`
// when the mask is not the frame's length or is not rank 1.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match ndbool.of_list([true, false, true], [3])
//         Ok(m)  =>
//             match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//                 Ok(t)  =>
//                     match dftable.filter(t, m)
//                         Ok(s)  => println("${dftable.rows(s)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn filter(t: DfTable, keep: NdMask) -> Result<DfTable, DfFault>
    let got = ndbool.size(keep)
    if got != t.rows or ndshape.rank(ndbool.shape(keep)) != 1
        return Err(DfBadMask(t.rows, got))
    let marks = ndbool.to_list(keep)
    var positions: [Int] = []
    for i in 0..t.rows
        if marks[i]
            list.push(positions, i)
    take(t, positions)

// The rows at these positions, in the order given.
//
// The gather every reordering in the package produces positions for.
// `DfRowOutOfRange` for a position off the frame.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2, 3])])
//         Ok(t)  =>
//             match dftable.take(t, [2, 0])
//                 Ok(s)  => println("${dftable.rows(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn take(t: DfTable, positions: [Int]) -> Result<DfTable, DfFault>
    for p in positions
        if p < 0 or p >= t.rows
            return Err(DfRowOutOfRange(p, t.rows))
    var out: [DfColumn] = []
    for c in t.columns
        list.push(out, dfcolumn.take(c, positions)!)
    Ok(DfTable { columns: out, rows: list.len(positions) })

// The frame ordered by these keys, first key outermost.
//
// The sort is stable: rows that agree on every key keep their original
// order.  Nulls go last in both directions.  `DfNoSuchColumn` for a key
// the frame does not have.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [3, 1, 2])])
//         Ok(t)  =>
//             match dftable.sort(t, [DfSortKey { column: "n", descending: false }])
//                 Ok(s)  => println("${dftable.rows(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn sort(t: DfTable, keys: [DfSortKey]) -> Result<DfTable, DfFault>
    take(t, sort_positions(t, keys)!)

// The positions that would sort this frame, without moving anything.
//
// What `sort` computes on the way.  `take` applies it, to this frame or
// to another frame of the same length.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [3, 1, 2])])
//         Ok(t)  =>
//             match dftable.sort_positions(t, [DfSortKey { column: "n", descending: false }])
//                 Ok(p)  => println("${p}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn sort_positions(t: DfTable, keys: [DfSortKey]) -> Result<[Int], DfFault>
    var ranked: [[Int]] = []
    for k in keys
        list.push(ranked, ranks(column(t, k.column)!, k.descending))
    // One stable sort per key, from the last key to the first.  Each
    // sort orders by the key's rank and breaks a tie by the position the
    // previous sorts left the row at, so the first key ends outermost.
    var order = list.range(0, t.rows)
    for n in list.range(0, list.len(keys))
        let rank = ranked[list.len(keys) - 1 - n]
        var pairs: [(Int, Int)] = []
        for i in 0..t.rows
            list.push(pairs, (rank[order[i]], i))
        list.sort(pairs)
        var next: [Int] = []
        for pair in pairs
            let (_, at) = pair
            list.push(next, order[at])
        order = next
    Ok(order)

// One row, as cells in column order.
//
// `DfRowOutOfRange` off the end.  A missing value is `DfNullCell`.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  =>
//             match dftable.row_cells(t, 1)
//                 Ok(cs) => println("${list.len(cs)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn row_cells(t: DfTable, row: Int) -> Result<[DfCell], DfFault>
    if row < 0 or row >= t.rows
        return Err(DfRowOutOfRange(row, t.rows))
    var out: [DfCell] = []
    for c in t.columns
        list.push(out, dfcolumn.cell(c, row)!)
    Ok(out)

// Every row as text, in column order — the shape a writer wants.
//
// `dfcell.render`'s rule, so a null is the empty string.  The header
// is `names`, kept separate because a caller writing a CSV needs the
// two apart anyway.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  => println("${list.len(dftable.to_rows(t))}")
//         Err(e) => println(e.message())
// ```
pub fn to_rows(t: DfTable) -> [[Str]]
    var texts: [[DfCell]] = []
    for c in t.columns
        list.push(texts, dfcolumn.cells_of(c))
    var out: [[Str]] = []
    for i in 0..t.rows
        var row: [Str] = []
        for cells in texts
            list.push(row, dfcell.render(cells[i]))
        list.push(out, row)
    out

// Two frames stacked, row-wise.
//
// The two frames must have the same column names, in any order.
// Columns are matched by name and not by position, and each matched
// pair must have the same kind.  The result has the top frame's column
// order.  `DfNoSuchColumn` names a column one side has and the other
// does not; `DfKindMismatch` names the kinds of a pair that disagrees.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1])])
//         Ok(t)  =>
//             match dftable.concat_rows(t, t)
//                 Ok(s)  => println("${dftable.rows(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn concat_rows(top: DfTable, bottom: DfTable) -> Result<DfTable, DfFault>
    for c in bottom.columns
        if not has(top, c.name)
            return Err(DfNoSuchColumn(c.name))
    var out: [DfColumn] = []
    for c in top.columns
        let other = column(bottom, c.name)!
        if dfcolumn.kind(other) != dfcolumn.kind(c)
            return Err(DfKindMismatch(dfcolumn.kind(c), dfcolumn.kind(other)))
        var cells = dfcolumn.cells_of(c)
        list.append(cells, dfcolumn.cells_of(other))
        list.push(out, dfcolumn.of_cells(c.name, cells, dfcolumn.kind(c))!)
    Ok(DfTable { columns: out, rows: top.rows + bottom.rows })

// The rows with no nulls in any of the named columns.
//
// "Complete cases", which is the first thing a notebook does to a
// loaded frame.  An empty `columns` list means every column.
// `DfNoSuchColumn` for a name the frame does not have.
//
// ```novo
// use dftable
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("n", [1, 2])])
//         Ok(t)  =>
//             match dftable.drop_nulls(t, [])
//                 Ok(s)  => println("${dftable.rows(s)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn drop_nulls(t: DfTable, columns: [Str]) -> Result<DfTable, DfFault>
    let chosen = if list.len(columns) == 0
        names(t)
    else
        columns
    var keep: [Bool] = []
    for _ in 0..t.rows
        list.push(keep, true)
    for n in chosen
        let c = column(t, n)!
        for i in 0..t.rows
            keep[i] = keep[i] and c.present[i]
    var positions: [Int] = []
    for i in 0..t.rows
        if keep[i]
            list.push(positions, i)
    take(t, positions)

// The rows `[start, stop)`, bounds already inside the frame.
fn window(t: DfTable, start: Int, stop: Int) -> DfTable
    var out: [DfColumn] = []
    for c in t.columns
        list.push(out, slice_column(c, start, stop))
    DfTable { columns: out, rows: stop - start }

fn slice_column(c: DfColumn, start: Int, stop: Int) -> DfColumn
    let cells = match c.cells
        DfFloatCells(vs) => DfFloatCells(vs[start:stop])
        DfIntCells(vs)   => DfIntCells(vs[start:stop])
        DfBoolCells(vs)  => DfBoolCells(vs[start:stop])
        DfStrCells(vs)   => DfStrCells(vs[start:stop])
    DfColumn { name: c.name, cells: cells, present: c.present[start:stop] }

// Each row's rank under one sort key: equal values share a rank, a
// smaller rank sorts first, and every null ranks after every value in
// both directions.
fn ranks(c: DfColumn, descending: Bool) -> [Int]
    let n = dfcolumn.len(c)
    var out: [Int] = []
    for _ in 0..n
        list.push(out, n)
    let cells = dfcolumn.cells_of(c)
    var distinct = 0
    let order = value_order(c)
    for i in 0..list.len(order)
        let row = order[i]
        if i > 0 and dfcell.compare(cells[order[i - 1]], cells[row]) != Some(Equal)
            distinct += 1
        out[row] = distinct
    if descending
        for row in order
            out[row] = distinct - out[row]
    out

// The present rows of a column, smallest value first, by the list sort
// of `(value, row)` pairs.  Floats follow the total order of SPEC
// section 13.6, which is `dfcell.compare`'s; a truth sorts as 0 or 1.
fn value_order(c: DfColumn) -> [Int]
    var rows: [Int] = []
    match c.cells
        DfFloatCells(vs) =>
            var pairs: [(Float, Int)] = []
            for i in 0..list.len(vs)
                if c.present[i]
                    list.push(pairs, (vs[i], i))
            list.sort(pairs)
            for pair in pairs
                let (_, row) = pair
                list.push(rows, row)
        DfIntCells(vs)   =>
            var pairs: [(Int, Int)] = []
            for i in 0..list.len(vs)
                if c.present[i]
                    list.push(pairs, (vs[i], i))
            list.sort(pairs)
            for pair in pairs
                let (_, row) = pair
                list.push(rows, row)
        DfBoolCells(vs)  =>
            var pairs: [(Int, Int)] = []
            for i in 0..list.len(vs)
                if c.present[i]
                    list.push(pairs, ((if vs[i] then 1 else 0), i))
            list.sort(pairs)
            for pair in pairs
                let (_, row) = pair
                list.push(rows, row)
        DfStrCells(vs)   =>
            var pairs: [(Str, Int)] = []
            for i in 0..list.len(vs)
                if c.present[i]
                    list.push(pairs, (vs[i], i))
            list.sort(pairs)
            for pair in pairs
                let (_, row) = pair
                list.push(rows, row)
    rows
