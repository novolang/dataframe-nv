// dfcell.nv — the four element types a column can hold, and one value
// out of one.
//
// A column holds 64-bit floats, 64-bit integers, truths or text.  A date
// column, a decimal column and a categorical column are left out: a date
// needs a calendar and a zone, a decimal needs its own arithmetic, and a
// category is an Int column with a dictionary kept beside it.
//
// A `DfCell` is one value, and the missing value is one of its variants,
// `DfNullCell`, rather than a `?DfCell`.  A caller reading a cell then
// asks one question, which variant it holds, instead of two.  The
// column's present mask is where missingness is stored; a cell is how one
// row's answer is handed back.

use std.str

// Which of the four types a column holds.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println(dfcell.kind_name(DfFloatKind))
// ```
pub enum DfKind
    // 64-bit floating point.  The type a measurement lands in, and the
    // one `dfcolumn.to_floats` produces for array arithmetic.
    DfFloatKind
    // 64-bit signed integer.  Counts, identifiers and row positions,
    // which stay exact where a double would not.
    DfIntKind
    // A truth.  A predicate's output, and the type `dfcolumn.mask`
    // converts to an `NdMask` for `dftable.filter`.
    DfBoolKind
    // Text.  Not parsed, not interned, not categorised — the bytes the
    // source had.
    DfStrKind

// One value from one row of one column, including the missing one.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println(dfcell.render(DfIntCell(42)))
// ```
pub enum DfCell
    // A number.
    DfFloatCell(value: Float)
    // An integer.
    DfIntCell(value: Int)
    // A truth.
    DfBoolCell(value: Bool)
    // Text.
    DfStrCell(value: Str)
    // Missing.  What that means in an aggregation, a sort and a join
    // key is written down once, in `dfcolumn`'s module comment.
    DfNullCell

// The kind a cell belongs to, or `None` for the missing one.
//
// `None` rather than a fifth `DfKind`, because "missing" is not a type
// a column can be: a null sits inside a Float column or a Str column,
// and the column's kind is what says which.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     match dfcell.kind_of(DfIntCell(1))
//         Some(k) => println(dfcell.kind_name(k))
//         None    => println("missing")
// ```
pub fn kind_of(c: DfCell) -> ?DfKind
    match c
        DfFloatCell(_) => Some(DfFloatKind)
        DfIntCell(_)   => Some(DfIntKind)
        DfBoolCell(_)  => Some(DfBoolKind)
        DfStrCell(_)   => Some(DfStrKind)
        DfNullCell     => None

// The kind's name, for a message or a `describe` row.
//
// Lower-case and one word — `float`, `int`, `bool`, `str` — because it
// appears inside sentences that a caller assembles.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println(dfcell.kind_name(DfStrKind))
// ```
pub fn kind_name(k: DfKind) -> Str
    match k
        DfFloatKind => "float"
        DfIntKind   => "int"
        DfBoolKind  => "bool"
        DfStrKind   => "str"

// One cell as text, for a message or a printed table.
//
// A null renders as the empty string, which is what a CSV writes.  A
// caller who wants "null" spelled out matches `DfNullCell`.  A float is
// written in its shortest form that reads back as the same number, with
// `.0` added when that form has no point or exponent, so that `1.0`
// reads back as a float and not as an integer.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println("[${dfcell.render(DfNullCell)}]")
// ```
pub fn render(c: DfCell) -> Str
    match c
        DfFloatCell(v) => float_text(v)
        DfIntCell(v)   => str.from_int(v)
        DfBoolCell(v)  => str.from_bool(v)
        DfStrCell(v)   => v
        DfNullCell     => ""

// One cell read out of text, at a named kind.
//
// The empty string is `DfNullCell` at every kind except `DfStrKind`,
// where it is the empty string.  Text that does not parse at the kind
// is `None`, which is a different answer from a null: the caller chooses
// between rejecting the row and treating the failure as missing.
//
// An integer is decimal digits with an optional sign.  A float is what
// `str.to_float` reads, which includes `nan` and `inf`.  A truth is
// `true` or `false`, in lower case.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     match dfcell.parse("42", DfIntKind)
//         Some(c) => println(dfcell.render(c))
//         None    => println("not an int")
// ```
pub fn parse(text: Str, k: DfKind) -> ?DfCell
    if text == ""
        return if k == DfStrKind then Some(DfStrCell("")) else Some(DfNullCell)
    match k
        DfFloatKind =>
            let Some(v) = str.to_float(text) else return None
            Some(DfFloatCell(v))
        DfIntKind   =>
            let Some(v) = str.to_int(text) else return None
            Some(DfIntCell(v))
        DfBoolKind  =>
            let Some(v) = str.to_bool(text) else return None
            Some(DfBoolCell(v))
        DfStrKind   => Some(DfStrCell(text))

// The narrowest kind every one of these strings parses at.
//
// The order is Int, then Float, then Bool, then Str — narrowest first,
// with Str as the answer that always works.  An empty string votes for
// nothing, so a column of numbers with gaps in it still comes out
// numeric.  This is what `dfcsv.infer_kinds` runs per column, and it is
// `pub` because a caller loading from somewhere else wants the same
// rule rather than their own.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println(dfcell.kind_name(dfcell.infer(["1", "", "3"])))
// ```
pub fn infer(texts: [Str]) -> DfKind
    var seen = false
    var ints = true
    var floats = true
    var bools = true
    for t in texts
        if t != ""
            seen = true
            ints = ints and str.to_int(t) != None
            floats = floats and str.to_float(t) != None
            bools = bools and str.to_bool(t) != None
    if not seen
        return DfStrKind
    if ints
        return DfIntKind
    if floats
        return DfFloatKind
    if bools
        return DfBoolKind
    DfStrKind

// How two cells order, for `dftable.sort`.
//
// `None` when they are not comparable: two different kinds, neither of
// them null.  A null is comparable with everything and orders after
// every value.  Floats follow the total order of SPEC section 13.6, with
// every not-a-number after every number; `false` orders before `true`;
// text orders by its bytes.

//
// ```novo
// use dfcell
//
// fn main() [io]
//     match dfcell.compare(DfIntCell(1), DfIntCell(2))
//         Some(o) => println("${o == Less}")
//         None    => println("not comparable")
// ```
pub fn compare(left: DfCell, right: DfCell) -> ?Ordering
    match (left, right)
        (DfNullCell, DfNullCell)         => Some(Equal)
        (DfNullCell, _)                  => Some(Greater)
        (_, DfNullCell)                  => Some(Less)
        (DfFloatCell(a), DfFloatCell(b)) => Some(float_order(a, b))
        (DfIntCell(a), DfIntCell(b))     => Some(order_of(a < b, a > b))
        (DfBoolCell(a), DfBoolCell(b))   => Some(order_of(not a and b, a and not b))
        (DfStrCell(a), DfStrCell(b))     => Some(order_of(a < b, a > b))
        _                                => None

// A text that two cells share exactly when they hold the same value.
//
// The key a group-by and a join match on.  It carries the kind, so an
// Int 1 and a Str "1" never share one, and it is length-prefixed, so the
// keys of several columns can be joined into one without two different
// tuples meeting.  The two zeros of a float share a key, and so does
// every not-a-number.  The null cell has a key of its own; whether two
// nulls then match is the caller's rule, and `dfcolumn`'s module comment
// states it for this package.
//
// ```novo
// use dfcell
//
// fn main() [io]
//     println("${dfcell.key(DfIntCell(1)) == dfcell.key(DfStrCell("1"))}")
// ```
pub fn key(c: DfCell) -> Str
    match c
        DfFloatCell(v) => tagged("f", float_text((if v == 0.0 then 0.0 else v)))
        DfIntCell(v)   => tagged("i", str.from_int(v))
        DfBoolCell(v)  => tagged("b", str.from_bool(v))
        DfStrCell(v)   => tagged("s", v)
        DfNullCell     => "n"

// A float as text that reads back as a float.  The shortest round-trip
// form, with `.0` added when that form would read back as an integer, so
// that a Float column written out and inferred again is a Float column.
fn float_text(v: Float) -> Str
    let t = str.from_float(v)
    if str.contains(t, ".") or str.contains(t, "e") or str.contains(t, "n")
        return t
    "${t}.0"

fn tagged(tag: Str, text: Str) -> Str
    "${tag}${str.len(text)}:${text}"

fn order_of(less: Bool, greater: Bool) -> Ordering
    if less
        return Less
    if greater
        return Greater
    Equal

// The total order of SPEC section 13.6: every not-a-number after every
// number, and equal to each other.
fn float_order(a: Float, b: Float) -> Ordering
    let a_nan = a != a
    let b_nan = b != b
    if a_nan or b_nan
        return order_of(b_nan and not a_nan, a_nan and not b_nan)
    order_of(a < b, a > b)
