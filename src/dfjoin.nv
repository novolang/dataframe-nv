// dfjoin.nv — two frames matched on one key column.
//
// There are two kinds of join, inner and left.  A right join is a left
// join with the frames the other way round.
//
// A join has one key column on each side.  A compound key is a column
// the caller makes first, for example by casting the parts to Str and
// concatenating them.
//
// A null key matches nothing, not even another null.  In an inner join a
// row with a null key does not appear; in a left join it appears with
// every right column null, as an unmatched row does.  `dfcolumn`'s
// module comment states the rule for the whole package.
//
// The result is in the left frame's row order, and the matches of one
// left row are in the right frame's order.  A left key that matches
// several right rows appears once per match, so a result can be longer
// than both inputs.

use dfcell
use dfcolumn
use dftable

// Which rows survive a join.
//
// ```novo
// use dfjoin
//
// fn main() [io]
//     println("${DfInnerJoin == DfInnerJoin}")
// ```
pub enum DfJoinKind
    // Only rows whose key is present on both sides.
    DfInnerJoin
    // Every left row, with the right columns null where nothing
    // matched.  A left row with a null key is kept and unmatched, for
    // the reason in the module comment.
    DfLeftJoin

// Two frames joined on a column of the same name in both.
//
// The common case, and the one a notebook writes.  `join_on` is the
// same thing when the two columns are named differently.
//
// The result carries every left column, then every right column except
// the key — which appears once, from the left, because two identical
// columns side by side is never what was wanted.  A right column whose
// name collides with a left one gets `_right` appended;
// `join_with_suffix` is how a caller picks a different one.
//
// `DfNoSuchColumn` when either side lacks the key, and
// `DfKindMismatch` when the two key columns are different types — a
// join between an Int id and a Str id is a mistake, not a conversion
// this package should perform.
//
// ```novo
// use dfjoin
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("id", [1, 2])])
//         Ok(l)  =>
//             match dfjoin.join(l, l, "id", DfInnerJoin)
//                 Ok(j)  => println("${dftable.rows(j)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn join(left: DfTable, right: DfTable, on: Str, how: DfJoinKind) -> Result<DfTable, DfFault>
    join_with_suffix(left, right, on, on, how, "_right")

// Two frames joined on differently named key columns.
//
// The key appears once in the result, under the left column's name.
// Everything else is `join`'s rule.
//
// ```novo
// use dfjoin
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("id", [1, 2])])
//         Ok(l)  =>
//             match dftable.of_columns([dfcolumn.ints("customer", [1, 3])])
//                 Ok(r)  =>
//                     match dfjoin.join_on(l, r, "id", "customer", DfLeftJoin)
//                         Ok(j)  => println("${dftable.rows(j)}")
//                         Err(e) => println(e.message())
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn join_on(left: DfTable, right: DfTable, left_on: Str, right_on: Str,
               how: DfJoinKind) -> Result<DfTable, DfFault>
    join_with_suffix(left, right, left_on, right_on, how, "_right")

// `join_on` with the collision suffix named.
//
// A right column whose name is already a left column's gets the suffix
// appended.  An empty suffix makes a collision `DfDuplicateColumn`
// instead, for a caller that must not have a column renamed.  A
// suffixed name that collides again is `DfDuplicateColumn` too.
//
// ```novo
// use dfjoin
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("id", [1])])
//         Ok(l)  =>
//             match dfjoin.join_with_suffix(l, l, "id", "id", DfInnerJoin, "_b")
//                 Ok(j)  => println("${dftable.names(j)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn join_with_suffix(left: DfTable, right: DfTable, left_on: Str, right_on: Str, how: DfJoinKind,
                        suffix: Str) -> Result<DfTable, DfFault>
    let pairs = join_positions(left, right, left_on, right_on, how)!
    let lp = pairs[0]
    let rp = pairs[1]
    var out: [DfColumn] = []
    for c in left.columns
        list.push(out, dfcolumn.take(c, lp)!)
    let taken = dftable.names(left)
    for c in right.columns
        if c.name != right_on
            var name = c.name
            if list.contains(taken, name)
                if suffix == ""
                    return Err(DfDuplicateColumn(name))
                name = name + suffix
            list.push(out, dfcolumn.rename(take_or_null(c, rp), name))
    dftable.of_columns(out)

// The matching row positions, as two lists, without building a frame.
//
// What a join computes on the way, as two lists: the answer's first
// list holds left positions and its second the right positions, and
// entry `i` of each is the `i`-th matching pair.  In a left join an
// unmatched left row carries -1 on the right.  A sentinel is used
// rather than an option so the positions stay a plain list of Int.
//
// A caller who wants only some columns of a join gathers them with
// `dfcolumn.take`, without building the whole joined frame.

//
// ```novo
// use dfjoin
//
// fn main() [io]
//     match dftable.of_columns([dfcolumn.ints("id", [1, 2])])
//         Ok(l)  =>
//             match dfjoin.join_positions(l, l, "id", "id", DfInnerJoin)
//                 Ok(p)  => println("${list.len(p)}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn join_positions(left: DfTable, right: DfTable, left_on: Str, right_on: Str,
                      how: DfJoinKind) -> Result<[[Int]], DfFault>
    let lk = dftable.column(left, left_on)!
    let rk = dftable.column(right, right_on)!
    if dfcolumn.kind(lk) != dfcolumn.kind(rk)
        return Err(DfKindMismatch(dfcolumn.kind(lk), dfcolumn.kind(rk)))
    // The right rows grouped by key, each group in the right frame's
    // order.  A null key is left out, so it matches nothing.
    let right_cells = dfcolumn.cells_of(rk)
    var index: HashMap<Str, Int> = HashMap.new()
    var group_of: [Int] = []
    var sizes: [Int] = []
    for cell in right_cells
        if cell == DfNullCell
            list.push(group_of, -1)
        else
            let text = dfcell.key(cell)
            match index.get(text)
                Some(g) =>
                    list.push(group_of, g)
                    sizes[g] = sizes[g] + 1
                None    =>
                    let g = list.len(sizes)
                    index.set(text, g)
                    list.push(group_of, g)
                    list.push(sizes, 1)
    var starts: [Int] = [0]
    for n in sizes
        list.push(starts, starts[list.len(starts) - 1] + n)
    var next = list.clone(starts)
    var members: [Int] = []
    for _ in right_cells
        list.push(members, 0)
    for i in 0..list.len(right_cells)
        let g = group_of[i]
        if g >= 0
            members[next[g]] = i
            next[g] = next[g] + 1
    var lp: [Int] = []
    var rp: [Int] = []
    var i = 0
    for cell in dfcolumn.cells_of(lk)
        let found = if cell == DfNullCell
            None
        else
            index.get(dfcell.key(cell))
        match found
            Some(g) =>
                for m in members[starts[g]:starts[g + 1]]
                    list.push(lp, i)
                    list.push(rp, m)
            None    =>
                if how == DfLeftJoin
                    list.push(lp, i)
                    list.push(rp, -1)
        i += 1
    Ok([lp, rp])

// The rows at these positions, with a null wherever the position is -1.
// Every other position is inside the column.
fn take_or_null(c: DfColumn, positions: [Int]) -> DfColumn
    var present: [Bool] = []
    for p in positions
        list.push(present, p >= 0 and c.present[p])
    let cells = match c.cells
        DfFloatCells(vs) =>
            var out: [Float] = []
            for p in positions
                list.push(out, (if p >= 0 then vs[p] else 0.0))
            DfFloatCells(out)
        DfIntCells(vs)   =>
            var out: [Int] = []
            for p in positions
                list.push(out, (if p >= 0 then vs[p] else 0))
            DfIntCells(out)
        DfBoolCells(vs)  =>
            var out: [Bool] = []
            for p in positions
                list.push(out, p >= 0 and vs[p])
            DfBoolCells(out)
        DfStrCells(vs)   =>
            var out: [Str] = []
            for p in positions
                if p >= 0
                    list.push(out, vs[p])
                else
                    list.push(out, "")
            DfStrCells(out)
    DfColumn { name: c.name, cells: cells, present: present }
